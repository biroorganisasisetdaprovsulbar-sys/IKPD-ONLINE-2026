.welcome{

background:white;
padding:25px;
border-radius:20px;
box-shadow:0 8px 20px #ddd;

}



.summary{

display:grid;

grid-template-columns:
repeat(4,1fr);

gap:20px;

margin:25px 0;

}



.summary-card{

background:white;

padding:25px;

border-radius:18px;

box-shadow:
0 5px 20px rgba(0,0,0,.08);

}



.summary-card h2{

font-size:38px;

}



.chart-box{

background:white;

padding:30px;

border-radius:20px;

margin-bottom:25px;

}



.ranking{

background:white;

padding:30px;

border-radius:20px;

}



.rank-item{

display:flex;

justify-content:space-between;

padding:15px;

border-bottom:1px solid #eee;

font-size:18px;

}



.green{

color:#16a34a;

}


.red{

color:#dc2626;

}
